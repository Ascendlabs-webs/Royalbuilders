# Sanity CMS — copy to .env.local and fill in (never commit real tokens)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only: read token for private datasets / draft preview (Viewer role is enough)
SANITY_API_READ_TOKEN=

# Server-only: write token for CRM publish via /api/properties (Editor role)
SANITY_API_WRITE_TOKEN=

# Server-only: shared secret for Sanity webhook -> /api/revalidate
SANITY_REVALIDATE_SECRET=
